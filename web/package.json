{
  "name": "silver-chronicles-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools/pbs/tsconfig.json",
    "test": "vitest run",
    "pbs": "node tools/pbs/compile.ts",
    "convert": "ruby tools/convert/convert.rb",
    "audio": "node tools/sound/convert.ts"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
