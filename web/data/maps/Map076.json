            {"cmd":"text","text":"I am stuck here and was wondering if you could deliver it..."},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"He's on Route 31."},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"Can you help a guy out?"},
            {
              "cmd": "choices",
              "choices": ["Yes","No"],
              "branches": [
                [
                  {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                  {"cmd":"text","text":"Wow, thanks!"},
                  {
                    "cmd": "if",
                    "cond": {
                      "script": {
                        "call": "pbAddForeignPokemon",
                        "args": [
                          "SPEAROW",
                          20,
                          {"call":"_I","args":["Webster"]},
                          {"call":"_I","args":["Kenya"]}
                        ]
                      }
                    },
                    "then": [
                      {
                        "cmd": "script",
                        "ruby": "pkmn = $player.last_party\npkmn.item = :GRASSMAIL\npkmn.calc_stats"
                      },
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {"cmd":"text","text":"My friend is on Route 31."},
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {
                        "cmd": "text",
                        "text": "Oh, yeah.\\nThere was a weird tree block the road.\\nI wonder if it's been cleared? "
                      },
                      {"cmd":"call","fn":"advanceQuestToStage","args":["LetterDeliver",2]},
                      {"cmd":"switches","from":687,"to":687,"value":true},
                      {"cmd":"selfSwitch","ch":"A","value":true}
                    ],
                    "else": [
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {"cmd":"text","text":"\\bOh, you don't have any space for it."},
                      {
                        "cmd": "if",
                        "cond": {
                          "script": {"op":"!","value":{"call":"isQuestActive?","args":["LetterDeliver"]}}
                        },
                        "then": [{"cmd":"call","fn":"activateQuest","args":["LetterDeliver"]}]
                      }
                    ]
                  }
                ],
                [
                  {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                  {"cmd":"text","text":"Oh... Never mind, then...\\nYou must be busy, too."},
                  {
                    "cmd": "if",
                    "cond": {"script":{"op":"!","value":{"call":"isQuestActive?","args":["LetterDeliver"]}}},
                    "then": [{"cmd":"call","fn":"activateQuest","args":["LetterDeliver"]}]
                  }
                ]
