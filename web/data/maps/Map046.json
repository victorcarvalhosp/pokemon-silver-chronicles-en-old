                          "than or equal to the min level."
                        ]
                      },
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {"cmd":"text","text":"Let's go!"},
                      {
                        "cmd": "script",
                        "ruby": "result = pbTriadDuel(\"George\", 0, 5, [\"elements\", \"noprize\"], \n[:MAGIKARP,:SENTRET,:MARILL,:TOGEPI,:HOPPIP])\npbSet(2, result)"
                      },
                      {
                        "cmd": "if",
                        "cond": {"variable":2,"op":"==","value":1},
                        "then": [
                          {"cmd":"comment","lines":["You won!"]},
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {"cmd":"text","text":"That was a great duel!"},
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {"cmd":"text","text":"Take this card as the prize for the win."},
                          {"cmd":"call","fn":"pbGiveTriadCardWithAnimation","args":["MARILL"]},
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {"cmd":"selfSwitch","ch":"A","value":true}
                        ],
                        "else": [
                          {"cmd":"comment","lines":["You won!"]},
                          {
                            "cmd": "if",
