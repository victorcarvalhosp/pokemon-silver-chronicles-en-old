                      "cmd": "text",
                      "text": "\\bEste TM contém EARTHQUAKE, é um dos ataques mais poderosos."
                    },
                    {"cmd":"text","text":"\\bMas de nada adianta esse envelope aqui comigo..."},
                    {
                      "cmd": "text",
                      "text": "\\bNa Rota 16 um de nossos melhores investigadores está investigando a Equipe Rocket."
                    },
                    {
                      "cmd": "text",
                      "text": "\\bLeve isso para ele, acho que essa informação é muito importante!\\nE ele certamente vai te recompensar por isso."
                    },
                    {"cmd":"switches","from":275,"to":275,"value":true}
                  ]
                }
              ],
              "else": [
                {"cmd":"text","text":"\\bHmmm...Esta é a Insígnia do Ginásio de Fuschia!"},
                {"cmd":"text","text":"\\bVocê quer ajudar nas investigações a Equipe Rocket?"},
                {"cmd":"text","text":"\\bEntão tenho um serviço para você."},
                {
