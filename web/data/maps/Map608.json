          "list": [
            {"cmd":"switches","from":351,"to":351,"value":true},
            {"cmd":"showAnimation","character":0,"animation":17},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"\\f[facebill]\\bHey! There's nothing for you here!"},
            {"cmd":"comment","lines":["EndSpeech: Err...\\nMe desculpe..."]},
            {
              "cmd": "if",
              "cond": {
                "script": {
                  "call": "TrainerBattle.start",
                  "args": [{"call":"PBTrainers::PkMnTRAINER_Bill"},"Bill",0]
                }
              },
              "then": [
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {
                  "cmd": "text",
                  "text": "\\f[facebill]\\bOh, sorry \\PN, it's dark here, so when I saw you come in I thought it was an intruder."
                },
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {
                  "cmd": "text",
                  "text": "\\f[facebill]\\bI've been living in this lighthouse for quite some time now."
                },
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {
                  "cmd": "text",
                  "text": "\\f[facebill]\\bI'm searching for the legendary Pokémon that lives in these seas."
                },
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {
                  "cmd": "text",
                  "text": "\\f[facebill]\\bIf I could see it, it would be a great achievement for me."
                },
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {
                  "cmd": "text",
                  "text": "\\f[facebill]\\bAnyway, I made another one of my inventions, I don't know yet if it's working, but maybe you can try it somewhere in your journey?"
                },
                {
                  "cmd": "if",
                  "cond": {"script":{"call":"pbReceiveItem","args":["BILLSENGINE"]}},
                  "then": [
                    {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                    {
                      "cmd": "text",
                      "text": "\\f[facebill]\\bIt's a more modern and portable version of the machine that can bring fossil Pokémon back to life, that you probably saw in Cinnabar Island."
                    },
                    {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                    {
                      "cmd": "text",
                      "text": "\\f[facebill]\\bIf it works, it you'll be able to reanimate dormant fossil cells.\\nThe bigger machine in Cinnabar is still needed in most cases, but if the fossil is just dormant this should work!"
                    },
                    {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                    {
                      "cmd": "text",
                      "text": "\\f[facebill]\\bThere's a cave east from here that might contain some dormant fossils. You could test it there."
                    },
                    {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                    {
                      "cmd": "text",
                      "text": "\\f[facebill]\\bMeanwhile, I'll stay here to observe the legends of the Orange Archipelago."
                    },
                    {"cmd":"call","fn":"activateQuest","args":["BillsEngine"]},
                    {"cmd":"selfSwitch","ch":"A","value":true}
                  ],
                  "else": [{"cmd":"comment","lines":["-- The item couldn't be added"]}]
                }
              ],
              "else": []
            }
          ]
        },
