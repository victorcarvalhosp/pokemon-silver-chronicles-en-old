    {
      "id": 8,
      "name": "EV008",
      "x": 10,
      "y": 4,
      "pages": [
        {
          "condition": {"switch1":43,"switch2":null,"variable":null,"selfSwitch":null},
          "graphic": {
            "tileId": 0,
            "characterName": "fk035",
            "characterHue": 0,
            "direction": 2,
            "pattern": 0,
            "opacity": 255,
            "blendType": 0
          },
          "moveType": 0,
          "moveSpeed": 3,
          "moveFrequency": 3,
          "moveRoute": {"repeat":true,"skippable":false,"list":[]},
          "walkAnime": true,
          "stepAnime": false,
          "directionFix": false,
          "through": false,
          "alwaysOnTop": false,
          "trigger": 0,
          "list": [
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {
              "cmd": "text",
              "text": "Long time no see, \\PN.\\nI've been waiting for you. \\nThis is from Professor Elm."
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"The thing is...we would like you to take care of an Egg!"},
            {
              "cmd": "if",
              "cond": {"script":{"op":">=","left":{"call":"$player.party.length"},"right":6}},
              "then": [
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {
                  "cmd": "text",
                  "text": "You already have 6 Pokémon with you, so you can't carry this Egg."
                },
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"Make some space in your party and come back."},
                {"cmd":"exitEvent"}
              ],
              "else": [
                {
                  "cmd": "if",
                  "cond": {
                    "script": {
                      "call": "pbGenerateEgg",
                      "args": ["TOGEPI",{"call":"_I","args":["Professor Elm"]}]
                    }
                  },
                  "then": [
                    {"cmd":"text","text":"\\me[Egg get]\\PN received the Egg from Professor Elm."},
                    {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                    {"cmd":"text","text":"\\bTake good care of it!"}
                  ],
                  "else": [
                    {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                    {"cmd":"text","text":"\\bOh, you can't carry it with you."},
                    {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                    {"cmd":"text","text":"\\bMake some space in your party and come back."}
                  ]
                },
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {
                  "cmd": "text",
                  "text": "After you left, Professor Elm received a phone call. I have no idea what they were talking about."
                },
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {
                  "cmd": "text",
                  "text": "But, after a while, Professor Elm suddenly cried out, \"I can't think of anyone more suited than \\PN!\""
                },
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"Then he insisted that I hand this Egg to you."},
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"That's how I came here to deliver the Egg to you."},
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {
                  "cmd": "text",
                  "text": "It seems that a Pokémon will hatch from it only when you keep it in your party of Pokémon."
                },
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"That's another reason we've chosen you, \\PN."},
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"Please take care of it!"},
                {
                  "cmd": "call",
                  "fn": "advanceQuestToStage",
                  "args": ["TogepiEgg",2,{"call":"colorQuest","args":["default"]}]
                },
                {
                  "cmd": "if",
                  "cond": {"character":-1,"direction":8},
                  "then": [
                    {
                      "cmd": "moveRoute",
                      "character": 0,
                      "route": {
