              "cmd": "choices",
              "choices": ["Yes","No"],
              "branches": [
                [
                  {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                  {"cmd":"text","text":"Ok, let's see if his hard work really paid off!"},
                  {"cmd":"call","fn":"setBattleRule","args":["backdrop","indoor4"]},
                  {
                    "cmd": "if",
                    "cond": {"script":{"call":"TrainerBattle.start","args":["SALARYMAN","Richard"]}},
                    "then": [
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {"cmd":"text","text":"Good. That’s what I wanted to see."},
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {"cmd":"text","text":"When you talk to your dad, tell him I met you."},
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {
                        "cmd": "text",
                        "text": "Tell him you’re actually out there living the thing he used to talk about."
                      },
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {
                        "cmd": "text",
                        "text": "And tell him... it’s alright that he never became a Trainer."
                      },
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {"cmd":"text","text":"Some people build the road for someone else to walk."},
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {"cmd":"text","text":"Here, take this."},
