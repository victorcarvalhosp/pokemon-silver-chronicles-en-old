                  {"move":"right"},
                  {"move":"right"},
                  {"move":"right"},
                  {"move":"right"},
                  {"move":"turnRight"}
                ]
              }
            },
            {"cmd":"waitForMoveCompletion"},
            {"cmd":"call","fn":"pbCallBub","args":[2,12]},
            {
              "cmd": "text",
              "text": "\\f[facegiovanni]\\bGet all my allies into the conference room. Now!"
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,12]},
            {"cmd":"text","text":"\\f[facegiovanni]\\bWe need to discuss the Mew situation."},
            {"cmd":"call","fn":"pbCallBub","args":[2,12]},
            {
              "cmd": "text",
              "text": "\\f[facegiovanni]\\bAnd make sure we're not disturbed. No cameras, no recording devices.\\nThis meeting doesn't exist, understood?"
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,21]},
            {"cmd":"text","text":"\\f[facelt.surge]Lt. Surge: Yes, sir!"},
            {
