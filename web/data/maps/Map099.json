            },
            {
              "cmd": "if",
              "cond": {"variable":1,"op":"==","value":1},
              "then": [
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {
                  "cmd": "text",
                  "text": "\\f[jasmine]...You are a better Trainer than me, in both skill and kindness."
                },
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {
                  "cmd": "text",
                  "text": "\\f[jasmine]In accordance with the League rules, I confer upon you this Badge."
                },
                {"cmd":"playMe","audio":{"name":"PkmRS-Badge","volume":100,"pitch":100}},
                {"cmd":"text","text":"\\PN received the Mineral Badge from Jasmine!"},
                {"cmd":"assign","target":"$player.badges[]","args":[5],"op":"=","value":true},
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {
                  "cmd": "text",
                  "text": "\\f[jasmine]With that Badge, all Pokémon, including traded Pokémon up to Lv. 70, will obey you without question."
                },
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"\\f[jasmine]Um... Please take this, too..."},
                {
