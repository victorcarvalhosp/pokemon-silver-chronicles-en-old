          "list": [
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"\\f[jasmine]Thank you for your help at the Lighthouse..."},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {
              "cmd": "text",
              "text": "\\f[jasmine]But this is different. Please allow me to introduce myself."
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {
              "cmd": "text",
              "text": "\\f[jasmine]I am Jasmine, a Gym Leader.\\nI use the...clang!\\nSteel type!"
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"\\f[jasmine]...Do you know about the Steel type?"},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {
              "cmd": "text",
              "text": "\\f[jasmine]They are very hard, cold, sharp, and really strong!\\nUm... I'm not lying."
            },
            {
              "cmd": "if",
              "cond": {"script":{"op":"<=","left":{"call":"$player.badge_count"},"right":4}},
              "then": [
                {
                  "cmd": "if",
