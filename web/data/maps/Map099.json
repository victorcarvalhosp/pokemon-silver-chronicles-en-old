                    {"cmd":"text","text":"\\f[jasmine]It is called Iron Tail..."},
                    {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                    {
                      "cmd": "text",
                      "text": "\\f[jasmine]Your Pokémon will hit the target with its hard tail, occasionaly lowering the target's Defense..."
                    },
