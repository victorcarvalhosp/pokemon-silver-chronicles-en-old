    {
      "id": 3,
      "name": "Effort ribbon giver",
      "x": 11,
      "y": 6,
      "pages": [
        {
          "condition": {"switch1":null,"switch2":null,"variable":null,"selfSwitch":null},
          "graphic": {
            "tileId": 0,
            "characterName": "NPC 04",
            "characterHue": 0,
            "direction": 2,
            "pattern": 0,
            "opacity": 255,
            "blendType": 0
          },
          "moveType": 0,
          "moveSpeed": 3,
          "moveFrequency": 3,
          "moveRoute": {"repeat":true,"skippable":false,"list":[]},
          "walkAnime": true,
          "stepAnime": false,
          "directionFix": false,
          "through": false,
          "alwaysOnTop": false,
          "trigger": 0,
          "list": [
            {
              "cmd": "comment",
              "lines": [
                "Looks at the total EVs of the lead Pokémon, and ",
                "rewards a ribbon to it if the total is maxed (255)."
              ]
            },
            {
              "cmd": "script",
              "ruby": "pkmn = $player.first_pokemon\ntotal = 0\npkmn.ev.each_value { |v| total += v }\nmaxed = 0\nif total >= Pokemon::EV_LIMIT\n  maxed = 1\nend\nmaxed = 2 if pkmn.hasRibbon?(:EFFORT)\npbSet(1, pkmn.name)\npbSet(2, maxed)"
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"\\rOh?\\nYour \\v[1]..."},
            {
              "cmd": "if",
              "cond": {"variable":2,"op":"==","value":2},
              "then": [
                {"cmd":"comment","lines":["Pokémon already has an Effort Ribbon."]},
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"\\rOh! Your \\v[1], that Effort Ribbon looks good on it!"}
              ],
              "else": [
                {
                  "cmd": "if",
                  "cond": {"variable":2,"op":"==","value":1},
                  "then": [
                    {
                      "cmd": "comment",
                      "lines": [
                        "Pokémon has full EVs and does not already have an ",
                        "Effort Ribbon - give it that ribbon."
                      ]
                    },
                    {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                    {"cmd":"text","text":"\\rWent for it stupendously!"},
                    {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                    {"cmd":"text","text":"\\rAs its reward, please give it this Effort Ribbon."},
                    {"cmd":"script","ruby":"pkmn = $player.first_pokemon\npkmn.giveRibbon(:EFFORT)"},
                    {
                      "cmd": "text",
                      "text": "\\PN received the Effort Ribbon. \\me[Item get]\\wtnp[20]"
                    },
                    {"cmd":"text","text":"\\PN put the Effort Ribbon on \\v[1]."}
                  ],
                  "else": [
                    {"cmd":"comment","lines":["Pokémon does not have full EVs."]},
                    {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                    {"cmd":"text","text":"\\rYou have to go for it a little harder."},
                    {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                    {"cmd":"text","text":"\\rIf you do, I'll give your Pokémon something nice."}
                  ]
                }
              ]
            }
          ]
        }
      ]
