          "list": [
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"\\f[falkner]\\bI'm Falkner, the Violet City Pokémon Gym Leader!"},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {
              "cmd": "text",
              "text": "\\f[falkner]\\bPeople say you can clip Flying-type Pokémon's wings with a jolt of electricity..."
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"\\f[falkner]\\bI won't allow such insults to bird Pokémon!"},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {
              "cmd": "text",
              "text": "\\f[falkner]\\bI'll show you the real power of the magnificent bird Pokémon!"
            },
            {"cmd":"memorizeBgmBgs"},
            {
              "cmd": "if",
              "cond": {"script":{"call":"TrainerBattle.start","args":["LEADER_Falkner","Falkner"]}},
              "then": [
                {"cmd":"restoreBgmBgs"},
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {
                  "cmd": "text",
                  "text": "\\f[falkner]\\b...For pity's sake!\\nMy dad's cherished bird Pokémon..."
                },
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"\\f[falkner]\\bBut a defeat is a defeat.\\nAll right."},
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {
                  "cmd": "text",
                  "text": "\\f[falkner]\\bTake this official Pokémon League badge.\\nThis one is the Zephyr Badge."
                },
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"playMe","audio":{"name":"PkmRS-Badge","volume":100,"pitch":100}},
                {"cmd":"text","text":"\\PN received the Zephyr Badge from Falkner!"},
                {"cmd":"wait","seconds":1.0},
                {"cmd":"assign","target":"$player.badges[]","args":[0],"op":"=","value":true},
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {
                  "cmd": "text",
                  "text": "\\f[falkner]\\bWith that Badge, Pokémon, including traded Pokémon up to Lv. 20, will obey you without question."
                },
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {
                  "cmd": "text",
                  "text": "\\f[falkner]\\bI'll also give you a special permit that enables you to use the skill Fly anytime outside of battle."
                },
                {
                  "cmd": "if",
                  "cond": {"script":{"call":"pbReceiveItem","args":["LICENSE_FLY"]}},
                  "then": []
                },
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"\\b\\f[falkner]Take this too."},
                {
                  "cmd": "if",
                  "cond": {"script":{"call":"pbReceiveItem","args":["TM51"]}},
                  "then": [
                    {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                    {
                      "cmd": "text",
                      "text": "\\f[falkner]\\bBy using a TM, a Pokémon will instantly learn a new move."
                    },
                    {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                    {
                      "cmd": "text",
                      "text": "\\f[falkner]\\bTM 51 contains Roost.\\nIt restores half the max HP."
                    },
                    {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                    {
                      "cmd": "text",
                      "text": "\\f[falkner]\\bThere are Pokémon Gyms in cities and towns ahead. Make good use of them!"
                    },
                    {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                    {"cmd":"text","text":"\\f[falkner]\\bAs for your next move..."},
                    {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                    {"cmd":"text","text":"\\f[falkner]\\bI would suggest Azalea Town."},
                    {"cmd":"call","fn":"advanceQuestToStage","args":["JohtoGymChallenge",2]},
