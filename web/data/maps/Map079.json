          "list": [
            {
              "cmd": "if",
              "cond": {"script":{"call":"pbIsWeekday","args":[1,2,4,6]}},
              "then": [
                {
                  "cmd": "comment",
                  "lines": [
                    "Today is Tuesday (2), Thursday (4) or Saturday (6), ",
                    "and the Bug Contest is running today. The weekday's ",
                    "name is put in Game Variable 1."
                  ]
                },
                {
                  "cmd": "if",
                  "cond": {"script":{"call":"pbBugContestState.pbContestHeld?"}},
                  "then": [
                    {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                    {
                      "cmd": "text",
                      "text": "\\bWe hope you'll take part in a Bug-Catching Contest in the future!"
                    },
                    {"cmd":"exitEvent"}
                  ]
                },
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"\\bToday's \\v[1]."},
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"\\bThat means the Bug-Catching Contest is on today."},
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"\\bThe rules are simple."},
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {
                  "cmd": "text",
                  "text": "\\bUsing one of your Pokémon, catch a Bug-type Pokémon to be judged."
                },
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"\\bWould you like to give it a try?"},
                {
                  "cmd": "choices",
                  "choices": ["Yes","No"],
                  "branches": [
                    [
                      {
                        "cmd": "if",
                        "cond": {"script":{"call":"pbBoxesFull?"}},
                        "then": [
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {"cmd":"text","text":"\\bSorry, your PC boxes are full."},
                          {"cmd":"exitEvent"}
                        ]
                      },
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {
                        "cmd": "text",
                        "text": "\\bYou are only allowed to take 1 Pokémon into the Contest."
                      },
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {"cmd":"text","text":"\\bPlease choose which Pokémon you want to enter with."},
                      {
                        "cmd": "comment",
                        "lines": [
                          "Opens a screen for choosing an able Pokémon (i.e. a ",
                          "non-egg, non-fainted Pokémon).",
                          "The party index of the chosen Pokémon is put in ",
                          "Game Variable 1, and the chosen Pokémon's name is ",
                          "put in Game Variable 2."
                        ]
                      },
                      {"cmd":"call","fn":"pbChooseAblePokemon","args":[1,2]},
                      {
                        "cmd": "if",
                        "cond": {"variable":1,"op":"<","value":0},
                        "then": [
                          {"cmd":"comment","lines":["Cancelled choosing a Pokémon."]},
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {"cmd":"text","text":"\\bOK. We hope you'll take part in the future."},
                          {"cmd":"exitEvent"}
                        ],
                        "else": [
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {"cmd":"text","text":"\\bYou will be entering with \\v[2], then."},
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {
                            "cmd": "text",
                            "text": "\\bWe'll hold your other Pokémon while you compete."
                          },
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {
                            "cmd": "text",
                            "text": "\\PN's Pokémon were left with the Contest Helper.\\se[Pkmn exp full]\\wtnp[20]"
                          },
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {"cmd":"text","text":"\\bHere are the Sport Balls for the Contest."},
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {
                            "cmd": "text",
                            "text": "\\PN received 20 Sport Balls.\\me[Item get]\\wtnp[40]"
                          },
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {
                            "cmd": "text",
                            "text": "\\bThe person who gets the strongest bug Pokémon is the winner."
                          },
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {"cmd":"text","text":"\\bYou have 20 minutes."},
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {"cmd":"text","text":"\\bIf you run out of Sport Balls, you're done."},
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {
                            "cmd": "text",
                            "text": "\\bYou can keep the last Pokémon you catch as your own."
                          },
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {
                            "cmd": "text",
                            "text": "\\bGo out and catch the strongest Bug-type Pokémon you can find!"
                          },
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {
                            "cmd": "comment",
                            "lines": [
                              "- Set the map ID and X/Y coordinates of the spot the ",
                              "player is teleported to at the end for judging.",
                              "- Set the map IDs of reception maps which, if you ",
                              "enter them, will not immediately end the contest ",
                              "(those maps should prompt the player to go back into ",
                              "the contest's map or to end the contest)."
                            ]
                          },
                          {
                            "cmd": "comment",
                            "lines": [
                              "- Set the map ID of the map where the contest takes ",
                              "place (there can only be one). NPC participants have ",
                              "random wild Pokémon found on this map.",
                              "- Set the party index of the Pokémon chosen by the ",
                              "player to use in the contest.",
                              "- Start the contest with 20 Sport Balls."
                            ]
                          },
                          {"cmd":"call","fn":"pbBugContestState.pbSetJudgingPoint","args":[79,9,8]},
                          {"cmd":"call","fn":"pbBugContestState.pbSetReception","args":[79,77]},
                          {"cmd":"call","fn":"pbBugContestState.pbSetContestMap","args":[261]},
                          {
