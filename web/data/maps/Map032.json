            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"\\bSo good of you to come here!"},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {
              "cmd": "text",
              "text": "\\bThe Sprout Tower is a towering testament to ancient architecture and the grace of Bellsprout and is enveloped in an extraordinary legend."
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {
              "cmd": "text",
              "text": "\\bCenturies ago, it is said that a Bellsprout, revered and majestic, experienced a rare and powerful Dynamax transformation, growing to a staggering height of 100 feet. "
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"\\bThis event gave birth to the legend of the Sprout Tower."},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {
              "cmd": "text",
              "text": "\\bSince then, people and Pokémon test their bonds to build a bright future together.\\nI am the final test."
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"\\bAllow me to check the ties between you and your Pokémon!"},
            {
              "cmd": "if",
              "cond": {"script":{"call":"TrainerBattle.start","args":["ELDER","Li"]}},
              "then": [
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"\\bHmmm...\\nThe way you battle is quite elegant."},
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"\\bYou should be able to stand up to Falkner."},
                {"cmd":"call","fn":"completeQuest","args":["SproutTower"]},
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"\\bAnd you should be able to make good use of this..."},
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"\\bIt is a Dynamax Band..\\nTake it with you!"},
                {
                  "cmd": "if",
                  "cond": {"script":{"call":"pbGetKeyItem","args":["DYNAMAXBAND"]}},
                  "then": []
                },
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {
                  "cmd": "text",
                  "text": "There's a number of conditions you must meet if you hope to have your Pokémon Dynamax and take on that gigantic form."
                },
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {
                  "cmd": "text",
                  "text": "But don't worry, it will glow whenever you have the opportunity to Dynamax a Pokémon."
                },
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {
                  "cmd": "text",
                  "text": "You can try it on BELLSPROUT when you have the opportunity..."
                },
                {"cmd":"selfSwitch","ch":"A","value":true},
                {"cmd":"switches","from":40,"to":40,"value":true},
                {"cmd":"scrollMap","direction":2,"distance":2,"speed":4}
              ]
            }
