            {
              "cmd": "text",
              "text": "\\f[facemom]\\rI’m so happy we’re all here together! It’s been ages since we had a proper meal like this."
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
