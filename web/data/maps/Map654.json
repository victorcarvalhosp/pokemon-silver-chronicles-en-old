          "list": [
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"\\bUh...\\nOh, yes, I'm the Move Deleter."},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"\\bI can make Pokémon forget their moves."},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"\\bWould you like me to do that?"},
            {
              "cmd": "choices",
              "choices": ["Yes","No"],
              "branches": [
                [
                  {"cmd":"label","name":"ChoosePokemon"},
                  {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                  {"cmd":"text","text":"\\bWhich Pokémon should forget a move?"},
                  {"cmd":"call","fn":"pbChoosePokemon","args":[1,3]},
                  {
                    "cmd": "comment",
                    "lines": [
                      "If Game Variable 1 is less than 0, it means the player ",
                      "has canceled choosing a Pokémon."
                    ]
                  },
                  {
                    "cmd": "if",
                    "cond": {"variable":1,"op":"<","value":0},
                    "then": [
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {
                        "cmd": "text",
                        "text": "\\bCome again if there are moves that need to be forgotten."
                      }
                    ],
                    "else": [
                      {
                        "cmd": "if",
                        "cond": {"script":{"call":"egg?","on":{"call":"pbGetPokemon","args":[1]}}},
                        "then": [
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {"cmd":"text","text":"\\bWhat? No Egg should know any moves."},
                          {"cmd":"exitEvent"}
                        ]
                      },
                      {
                        "cmd": "if",
                        "cond": {"script":{"call":"shadowPokemon?","on":{"call":"pbGetPokemon","args":[1]}}},
                        "then": [
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {
                            "cmd": "text",
                            "text": "\\bWhat? I can't make a Shadow Pokémon forget a move."
                          },
                          {"cmd":"exitEvent"}
                        ]
                      },
                      {
                        "cmd": "if",
                        "cond": {
                          "script": {
                            "op": "==",
                            "left": {"call":"numMoves","on":{"call":"pbGetPokemon","args":[1]}},
                            "right": 1
                          }
                        },
                        "then": [
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {"cmd":"text","text":"\\b\\v[3] seems to know only one move..."},
                          {"cmd":"exitEvent"}
                        ]
                      },
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {"cmd":"text","text":"\\bWhich move should be forgotten?"},
                      {
                        "cmd": "call",
                        "fn": "pbChooseMove",
                        "args": [{"call":"pbGetPokemon","args":[1]},2,4]
                      },
                      {
                        "cmd": "if",
                        "cond": {"variable":2,"op":"<","value":0},
                        "then": [{"cmd":"jump","label":"ChoosePokemon"}],
                        "else": [
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {
                            "cmd": "text",
                            "text": "\\bHm! \\v[3]'s \\v[4]? That move should be forgotten?"
                          },
                          {
                            "cmd": "choices",
                            "choices": ["Yes","No"],
                            "branches": [
                              [
                                {
                                  "cmd": "playMe",
                                  "audio": {"name":"013-Gag02","volume":100,"pitch":100}
                                },
                                {"cmd":"wait","seconds":4.0},
                                {
                                  "cmd": "script",
                                  "ruby": "pbGetPokemon(1).forget_move_at_index(\n   pbGet(2))"
                                },
                                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                                {"cmd":"text","text":"\\bIt worked to perfection!"},
                                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                                {"cmd":"text","text":"\\b\\v[3] has forgotten \\v[4] completely."}
                              ],
                              [
                                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                                {
                                  "cmd": "text",
                                  "text": "\\bCome again if there are moves that need to be forgotten."
                                }
                              ]
                            ],
                            "cancel": 1
                          }
                        ]
                      }
