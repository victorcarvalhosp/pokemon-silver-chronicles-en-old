          "list": [
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {
              "cmd": "text",
              "text": "Bill: Hi, \\PN! Would you do something for me and take a Pokémon with you?"
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {
              "cmd": "text",
              "text": "It came over when I was doing an experiment to build a Time Capsule."
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {
              "cmd": "text",
              "text": "I'm not sure how it came over, but it seems to be a wild Pokémon."
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"Someone has to take care of it, but I don't like being outside."},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"Can I count on you to play with it, \\PN?"},
            {
              "cmd": "choices",
              "choices": ["Yes","No"],
              "branches": [
                [
                  {
                    "cmd": "if",
                    "cond": {"script":{"op":"<=","left":{"call":"$player.pokemon_count"},"right":5}},
                    "then": [
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {
                        "cmd": "text",
                        "text": "I knew you'd come through!\\nYou're the real deal! Way to go!\\nOK, I'm counting on you.\\nTake good care of it!"
                      },
                      {
                        "cmd": "if",
                        "cond": {"script":{"call":"pbAddPokemon","args":["SCREAMTAIL",15]}},
                        "then": [
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {
                            "cmd": "text",
                            "text": "I send this Pokémon information to Professor Elm, and he said he never saw it before."
                          },
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {
                            "cmd": "text",
                            "text": "So a new spot in the Pokédex was added for it!\\nHow cool is that?!"
                          },
                          {"cmd":"selfSwitch","ch":"A","value":true}
                        ],
                        "else": []
                      }
                    ],
                    "else": [
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {"cmd":"text","text":"Whoa, wait. You can't carry any more Pokémon."}
                    ]
                  }
                ],
                [
                  {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                  {"cmd":"text","text":"Oh... Now what to do?"}
                ]
              ],
              "cancel": 1
            }
          ]
        },
