          "trigger": 0,
          "list": [
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"I'm the Chairman of the Pokemon Fan Club."},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"I've raised over 150 Pokemon."},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"I'm very fussy when it comes to Pokemon."},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"Did you visit just to hear about my Pokemon?"},
            {
              "cmd": "choices",
              "choices": ["Yes","No"],
              "branches": [
                [
                  {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                  {"cmd":"text","text":"Good! Then listen up!"},
                  {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                  {"cmd":"text","text":"So... my precious Rapidash..."},
                  {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                  {
                    "cmd": "text",
                    "text": "It's... cute... lovely... smart... adorable... irresistible... plus... amazing... Don't you think so?\\nOh, so... wild... beaultiful... kind... I love it!"
                  },
                  {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                  {
                    "cmd": "text",
                    "text": "Hug it... It's warm and cuddly...\\nOh it's... spactacular... captivating... simply divine... I treasure it...\\nOops! Look at the time! I've kept you too long!"
                  },
                  {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                  {
                    "cmd": "text",
                    "text": "Thanks for hearing me out. I want to give you this present!"
                  },
                  {
                    "cmd": "if",
                    "cond": {"script":{"call":"pbReceiveItem","args":["RARECANDY"]}},
                    "then": [
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {"cmd":"text","text":"It's a Rare Candy that makes Pokemon stronger."},
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {
                        "cmd": "text",
                        "text": "I prefer making my Pokemon stronger by battling, so you can have it."
                      },
                      {"cmd":"selfSwitch","ch":"A","value":true}
                    ]
                  }
                ],
                [
                  {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                  {"cmd":"text","text":"How disappointing..."},
                  {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                  {"cmd":"text","text":"Come back if you want to listen to me again!"}
                ]
              ],
              "cancel": 1
            }
