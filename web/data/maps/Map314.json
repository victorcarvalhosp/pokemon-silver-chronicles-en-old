          "list": [
            {"cmd":"text","text":"\\Olá eu sou o Move Deleter."},
            {"cmd":"text","text":"Eu posso fazer Pokémos esquecerem golpes."},
            {"cmd":"text","text":"Você gostaria que eu fizesse isso?"},
            {
              "cmd": "choices",
              "choices": ["Sim","Não"],
              "branches": [
                [
                  {"cmd":"label","name":"ChoosePokemon"},
                  {"cmd":"text","text":"Qual Pokémon esquecerá um golpe?"},
                  {"cmd":"call","fn":"pbChoosePokemon","args":[1,3]},
                  {
                    "cmd": "comment",
                    "lines": [
                      "If variable 1 is less than 0, it means the player has ",
                      "canceled choosing a Pokemon."
                    ]
                  },
                  {
                    "cmd": "if",
                    "cond": {"variable":1,"op":"<","value":0},
                    "then": [{"cmd":"text","text":"Volte quando precisar que algum golpe seja deletado."}],
                    "else": [
                      {
                        "cmd": "if",
                        "cond": {"script":{"call":"egg?","on":{"call":"pbGetPokemon","args":[1]}}},
                        "then": [
                          {"cmd":"text","text":"O que?  Ovos não sabem nenhum golpe!"},
                          {"cmd":"exitEvent"}
                        ]
                      },
                      {
                        "cmd": "if",
                        "cond": {
                          "script": {
                            "op": "==",
                            "left": {"call":"pbNumMoves","args":[{"call":"pbGetPokemon","args":[1]}]},
                            "right": 1
                          }
                        },
                        "then": [
                          {
                            "cmd": "text",
                            "text": "\\v[3] knows only one move so it can't be forgotten..."
                          },
                          {"cmd":"exitEvent"}
                        ]
                      },
                      {"cmd":"text","text":"Which move should be forgotten?"},
                      {
                        "cmd": "call",
                        "fn": "pbChooseMove",
                        "args": [{"call":"pbGetPokemon","args":[1]},2,4]
                      },
                      {
                        "cmd": "if",
                        "cond": {"variable":2,"op":"<","value":0},
                        "then": [{"cmd":"jump","label":"ChoosePokemon"}],
                        "else": [
                          {"cmd":"text","text":"Hm!  \\v[3]'s \\v[4]?  Este golpe será esquecido?"},
                          {
                            "cmd": "choices",
                            "choices": ["Sim","Não"],
                            "branches": [
                              [
                                {
                                  "cmd": "playMe",
                                  "audio": {"name":"013-Gag02","volume":100,"pitch":100}
                                },
                                {"cmd":"wait","seconds":4.0},
                                {
                                  "cmd": "call",
                                  "fn": "pbDeleteMove",
                                  "args": [{"call":"pbGetPokemon","args":[1]},{"call":"pbGet","args":[2]}]
                                },
                                {"cmd":"text","text":"It worked to perfection!"},
                                {"cmd":"text","text":"\\v[3] has forgotten \\v[4] completely."}
                              ],
                              [
                                {
                                  "cmd": "text",
                                  "text": "Volte quando precisar que algum golpe seja deletado."
                                }
                              ]
                            ],
                            "cancel": 1
                          }
                        ]
                      }
                    ]
                  }
                ],
                [{"cmd":"text","text":"Volte quando precisar que algum golpe seja deletado."}]
              ],
              "cancel": 1
            }
          ]
        }
      ]
