            {"cmd":"text","text":"\\f[faceThorton]\\bI am Thorton, the newest Elite Four member."},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {
              "cmd": "text",
              "text": "\\f[faceThorton]\\bPleasure to meet me. Just so you know, my Pokémon knowledge is unbeatable."
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {
              "cmd": "text",
              "text": "\\f[faceThorton]\\bLet's see what I can see about you through my data-analyzing machine."
            },
            {
              "cmd": "script",
              "ruby": "names = []\nfor p in $player.party\n  next if p.egg?\n  names << p.speciesName\n  break if names.length >= 3\nend\n\n$game_variables[1] = names.length == 0 ? \"No usable Pokémon.\" :\n                     (names.length == 1 ? names[0] :\n                      names[0..-2].join(\", \") + \" and \" + names[-1])"
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"\\f[faceThorton]\\b\\v[1]..."},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"variables","from":1,"to":1,"op":"set","value":{"random":[10,99]}},
            {
              "cmd": "text",
              "text": "\\f[faceThorton]\\bI have to say, that's a good setup.\\nLike, say, \\v[1] percent?"
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {
              "cmd": "text",
              "text": "\\f[faceThorton]\\bOh, don't let that number concern you!\\nAll righty, let's get going!"
            },
            {"cmd":"variables","from":1,"to":1,"op":"set","value":{"random":[1,3]}},
