          "list": [
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {
              "cmd": "text",
              "text": "All my children have set out on their Pokémon journeys...\\nNow, only my wife and I remain in this house."
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"Things are a bit quiet around here..."},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"Back in the day, I used to battle a lot, alongside my children."},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"Our hearts beat as one in the battles."},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"Those were the good old days..."},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {
              "cmd": "text",
              "text": "So let's do this: if you give me a good battle, I'll give you something I have here as a gift."
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"Are you ready to battle me?"},
            {
              "cmd": "choices",
              "choices": ["Yes","No"],
              "branches": [
                [
                  {
                    "cmd": "if",
                    "cond": {
                      "script": {"op":"!","value":{"call":"isQuestActive?","args":["WinstrateBattle"]}}
                    },
                    "then": [{"cmd":"call","fn":"activateQuest","args":["WinstrateBattle"]}]
                  },
                  {"cmd":"comment","lines":["EndSpeech: Oh que bela batalha!"]},
                  {"cmd":"call","fn":"pbDeregisterPartner","args":[]},
                  {
                    "cmd": "if",
                    "cond": {"script":{"call":"TrainerBattle.start","args":["POKeFAN_Male_2","Victor"]}},
                    "then": [
                      {
                        "cmd": "if",
                        "cond": {"switch":431,"value":true},
                        "then": [
                          {
                            "cmd": "if",
                            "cond": {"switch":141,"value":true},
                            "then": [{"cmd":"commonEvent","id":37}],
                            "else": [{"cmd":"commonEvent","id":36}]
                          }
                        ]
                      },
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {
                        "cmd": "text",
                        "text": "Wow! I felt that old rush of adrenaline coursing through my veins!"
                      },
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {
                        "cmd": "text",
                        "text": "As promised, I'll give you something I have here with me."
                      },
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {
                        "cmd": "text",
                        "text": "I was going to give this to one of my children, but since it will be a while before they get back, I’ll give it to you instead.\\nI hope you like it."
                      },
                      {
                        "cmd": "if",
                        "cond": {"switch":409,"value":true},
                        "then": [
                          {
                            "cmd": "text",
                            "text": "\\bDentro dessa Pokébola há um Mudkip, um adorável Pokémon de água!\\nCuide bem dele."
                          },
                          {
                            "cmd": "script",
                            "ruby": "pkmn = Pokemon.new(:MUDKIP,15)\npbAddPokemon(pkmn)"
                          },
                          {"cmd":"selfSwitch","ch":"B","value":true}
                        ],
                        "else": [
                          {
                            "cmd": "if",
                            "cond": {"switch":410,"value":true},
                            "then": [
                              {
                                "cmd": "text",
                                "text": "\\bDentro da Pokébola há um Torchic, um adorável Pokémon de fogo!\\nCuide bem dele."
                              },
                              {
                                "cmd": "script",
                                "ruby": "pkmn = Pokemon.new(:TORCHIC,15)\npbAddPokemon(pkmn)"
                              },
                              {"cmd":"selfSwitch","ch":"B","value":true}
                            ],
                            "else": [
                              {
                                "cmd": "text",
                                "text": "\\bDentro da Pokébola há um Treecko, um adorável Pokémon de grama!\\nCuide bem dele."
                              },
                              {
                                "cmd": "script",
                                "ruby": "pkmn = Pokemon.new(:TREECKO,15)\npbAddPokemon(pkmn)"
                              },
                              {"cmd":"selfSwitch","ch":"B","value":true}
                            ]
                          }
                        ]
                      },
                      {"cmd":"call","fn":"completeQuest","args":["WinstrateBattle"]}
                    ]
                  }
                ],
                [
                  {
                    "cmd": "if",
