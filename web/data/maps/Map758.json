          "trigger": 0,
          "list": [
            {"cmd":"text","text":"Uh...  Oh, sim, sou o Deletador de Golpes.."},
            {"cmd":"text","text":"Posso fazer os Pokémons equecerem seus ataques."},
            {"cmd":"text","text":"Gostaria que eu faça isso?"},
            {
              "cmd": "choices",
              "choices": ["Sim","Não"],
              "branches": [
                [
                  {"cmd":"label","name":"ChoosePokemon"},
                  {"cmd":"text","text":"Qual Pokémon deveria esquecer um ataque?"},
                  {"cmd":"call","fn":"pbChoosePokemon","args":[1,3]},
                  {
                    "cmd": "comment",
                    "lines": [
                      "If variable 1 is less than 0, it means the player has ",
                      "canceled choosing a Pokemon."
                    ]
                  },
                  {
                    "cmd": "if",
                    "cond": {"variable":1,"op":"<","value":0},
                    "then": [{"cmd":"text","text":"Volte sempre que precisar."}],
                    "else": [
                      {
                        "cmd": "if",
                        "cond": {"script":{"call":"egg?","on":{"call":"pbGetPokemon","args":[1]}}},
                        "then": [
                          {"cmd":"text","text":"O que?  Ovos não sabem golpes..."},
                          {"cmd":"exitEvent"}
                        ]
                      },
                      {
                        "cmd": "if",
                        "cond": {
                          "script": {
                            "op": "==",
                            "left": {"call":"pbNumMoves","args":[{"call":"pbGetPokemon","args":[1]}]},
                            "right": 1
                          }
                        },
                        "then": [
                          {
                            "cmd": "text",
                            "text": "\\v[3] só sabe um golpe e não pode ser esquecido..."
                          },
                          {"cmd":"exitEvent"}
                        ]
                      },
                      {"cmd":"text","text":"Qual golpe deve ser esquecido?"},
                      {
                        "cmd": "call",
                        "fn": "pbChooseMove",
                        "args": [{"call":"pbGetPokemon","args":[1]},2,4]
                      },
                      {
                        "cmd": "if",
                        "cond": {"variable":2,"op":"<","value":0},
                        "then": [{"cmd":"jump","label":"ChoosePokemon"}],
                        "else": [
                          {
                            "cmd": "text",
                            "text": "Hm!  \\v[3]'s \\v[4]?  Esse golpe deve ser esquecido?"
                          },
                          {
                            "cmd": "choices",
                            "choices": ["Sim","Não"],
                            "branches": [
                              [
                                {
                                  "cmd": "playMe",
                                  "audio": {"name":"013-Gag02","volume":100,"pitch":100}
                                },
                                {"cmd":"wait","seconds":4.0},
                                {
                                  "cmd": "call",
                                  "fn": "pbDeleteMove",
                                  "args": [{"call":"pbGetPokemon","args":[1]},{"call":"pbGet","args":[2]}]
                                },
                                {"cmd":"text","text":"Isso funcionou perfeitamente!"},
                                {"cmd":"text","text":"\\v[3] esqueceu \\v[4] completamente."}
                              ],
                              [
                                {
                                  "cmd": "text",
                                  "text": "Volte sempre que precisar esquecer algum golpe."
                                }
                              ]
                            ],
