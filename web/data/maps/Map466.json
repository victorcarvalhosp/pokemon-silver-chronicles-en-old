          "trigger": 0,
          "list": [
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"\\bWelcome to Rocket Game Corner!"},
            {
              "cmd": "if",
              "cond": {"script":{"op":"!","value":{"call":"$bag.has?","args":["COINCASE"]}}},
              "then": [
                {
                  "cmd": "text",
                  "text": "\\G\\CN\\bDo you need some game coins?\\nWould you like to buy some?"
                },
                {"cmd":"text","text":"\\G\\CN\\bYou don't have a Coin Case."}
              ],
              "else": [
                {"cmd":"label","name":"Start menu"},
                {
                  "cmd": "text",
                  "text": "\\G\\CN\\bDo you need some game coins?\\nWould you like to buy some?"
                },
                {
                  "cmd": "choices",
                  "choices": ["50 coins [$1,000]","500 coins [$10,000]","Exit"],
                  "branches": [
                    [
                      {
                        "cmd": "if",
                        "cond": {
                          "script": {
                            "op": ">=",
                            "left": {"op":"+","left":{"call":"$player.coins"},"right":50},
                            "right": {"call":"Settings::MAX_COINS"}
                          }
                        },
                        "then": [{"cmd":"text","text":"\\G\\CN\\bWhoops!\\nYour Coin Case is full."}],
                        "else": [
                          {
                            "cmd": "if",
                            "cond": {"gold":"<=","value":999},
                            "then": [{"cmd":"text","text":"\\G\\CN\\bYou can't afford the coins."}],
                            "else": [
                              {"cmd":"gold","op":"sub","value":1000},
                              {
                                "cmd": "assign",
                                "target": "$player.coins",
                                "args": [],
                                "op": "+=",
                                "value": 50
                              },
                              {
                                "cmd": "playSe",
                                "audio": {"name":"Mart buy item","volume":100,"pitch":100}
                              },
                              {"cmd":"text","text":"\\G\\CN\\bThank you\\nHere are your coins!"}
                            ]
                          }
                        ]
                      }
                    ],
                    [
                      {
                        "cmd": "if",
                        "cond": {
                          "script": {
                            "op": ">=",
                            "left": {"op":"+","left":{"call":"$player.coins"},"right":500},
                            "right": {"call":"Settings::MAX_COINS"}
                          }
                        },
                        "then": [{"cmd":"text","text":"\\G\\CN\\bWhoops!\\nYour Coin Case is full."}],
                        "else": [
