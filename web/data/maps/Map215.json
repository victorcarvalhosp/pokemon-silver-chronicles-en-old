                [
                  {"cmd":"text","text":"Qual Pokemon que eu deveria trocar o nome?"},
                  {"cmd":"call","fn":"pbChoosePokemon","args":[1,3]},
                  {
                    "cmd": "if",
                    "cond": {"variable":1,"op":"<","value":0},
                    "then": [{"cmd":"text","text":"Vejo. Vêm visitar novamente."},{"cmd":"exitEvent"}]
                  },
                  {
                    "cmd": "if",
                    "cond": {"script":{"call":"egg?","on":{"call":"pbGetPokemon","args":[1]}}},
