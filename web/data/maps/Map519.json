          "moveType": 0,
          "moveSpeed": 3,
          "moveFrequency": 3,
          "moveRoute": {"repeat":true,"skippable":false,"list":[]},
          "walkAnime": true,
          "stepAnime": false,
          "directionFix": false,
          "through": false,
          "alwaysOnTop": false,
          "trigger": 0,
          "list": [
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"\\bHello, hello!\\nI am the official Name Rater!"},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"\\bWant me to rate the nicknames of your Pokémon?"},
            {
              "cmd": "choices",
              "choices": ["Yes","No"],
              "branches": [
                [
                  {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                  {"cmd":"text","text":"\\bWhich Pokémon's nickname should I critique?"},
                  {
                    "cmd": "comment",
                    "lines": [
                      "Opens a screen for choosing a Pokémon. The index ",
                      "is stored in Game Variable 1, and the name in Game ",
                      "Variable 3."
                    ]
                  },
                  {"cmd":"call","fn":"pbChoosePokemon","args":[1,3]},
                  {
                    "cmd": "comment",
                    "lines": [
                      "If Game Variable 1 is less than 0, it means the player ",
                      "has canceled choosing a Pokémon."
                    ]
                  },
                  {
                    "cmd": "if",
                    "cond": {"variable":1,"op":"<","value":0},
                    "then": [
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {"cmd":"text","text":"\\bI see.\\nDo come visit again."},
                      {"cmd":"exitEvent"}
                    ]
                  },
                  {"cmd":"comment","lines":["Check for eggs."]},
                  {
                    "cmd": "if",
                    "cond": {"script":{"call":"egg?","on":{"call":"pbGetPokemon","args":[1]}}},
                    "then": [
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {"cmd":"text","text":"\\bNow, now... That is merely an Egg!"},
                      {"cmd":"exitEvent"}
                    ]
                  },
                  {"cmd":"comment","lines":["Check for Shadow Pokémon."]},
                  {
                    "cmd": "if",
                    "cond": {"script":{"call":"shadowPokemon?","on":{"call":"pbGetPokemon","args":[1]}}},
                    "then": [
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {"cmd":"text","text":"\\bI wouldn't dare critique a Shadow Pokémon's name!"},
                      {"cmd":"exitEvent"}
                    ]
                  },
                  {
                    "cmd": "if",
                    "cond": {
                      "script": {
                        "call": "foreign?",
                        "on": {"call":"pbGetPokemon","args":[1]},
                        "args": [{"call":"$player"}]
                      }
                    },
                    "then": [
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {"cmd":"text","text":"\\bHmmm... \\v[3] it is!"},
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {
                        "cmd": "text",
                        "text": "\\bThis is a magnificent nickname! It is impeccably beyond reproach!"
                      },
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {
                        "cmd": "text",
                        "text": "\\bYou'll do well to cherish your \\v[3] now and beyond."
                      },
                      {"cmd":"exitEvent"}
                    ]
                  },
                  {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                  {"cmd":"text","text":"\\b\\v[3], is it?\\nThat is a decent nickname!"},
                  {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                  {"cmd":"text","text":"\\bBut, would you like me to give it a nicer name?"},
                  {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                  {"cmd":"text","text":"\\bHow about it?"},
                  {
                    "cmd": "choices",
                    "choices": ["Yes","No"],
                    "branches": [
                      [
                        {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                        {"cmd":"text","text":"\\bAh, good. Then, what shall the new nickname be?"},
                        {
                          "cmd": "script",
                          "do": [
                            {
                              "cmd": "assign",
                              "target": "pkmn",
                              "args": [],
                              "op": "=",
                              "value": {"call":"pbGetPokemon","args":[1]}
                            },
                            {
                              "cmd": "assign",
                              "target": "species",
                              "args": [],
                              "op": "=",
                              "value": {"call":"speciesName","on":{"call":"pkmn"}}
                            },
                            {"cmd":"call","fn":"pbSet","args":[4,{"call":"species"}]},
                            {
                              "cmd": "call",
                              "fn": "pbTextEntry",
                              "args": [
                                {"op":"+","left":{"call":"species"},"right":"'s nickname?"},
                                0,
                                {"call":"Pokemon::MAX_NAME_SIZE"},
                                5
                              ]
                            }
                          ]
                        },
                        {
                          "cmd": "if",
                          "cond": {
                            "script": {
                              "op": "||",
                              "left": {
                                "op": "==",
                                "left": {"call":"pbGet","args":[5]},
                                "right": {"call":"pbGet","args":[3]}
                              },
                              "right": {
                                "op": "&&",
                                "left": {"op":"==","left":{"call":"pbGet","args":[5]},"right":""},
                                "right": {
                                  "op": "==",
                                  "left": {"call":"pbGet","args":[3]},
                                  "right": {"call":"pbGet","args":[4]}
                                }
                              }
                            }
                          },
                          "then": [
                            {"cmd":"comment","lines":["The Pokémon's nickname wasn't changed."]},
                            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                            {
                              "cmd": "text",
                              "text": "\\bI see. You're right, there's no need to change this Pokémon's nickname."
                            },
                            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                            {"cmd":"text","text":"\\bIt already had a superb name!"}
                          ],
                          "else": [
                            {
                              "cmd": "if",
                              "cond": {
                                "script": {
                                  "op": "||",
                                  "left": {"op":"==","left":{"call":"pbGet","args":[5]},"right":""},
                                  "right": {
                                    "op": "==",
                                    "left": {"call":"pbGet","args":[5]},
                                    "right": {"call":"pbGet","args":[4]}
                                  }
                                }
                              },
                              "then": [
                                {
                                  "cmd": "comment",
                                  "lines": ["Resets the Pokémon's nickname to the species name."]
                                },
                                {
                                  "cmd": "script",
                                  "do": [
                                    {
                                      "cmd": "assign",
                                      "target": "pkmn",
                                      "args": [],
                                      "op": "=",
                                      "value": {"call":"pbGetPokemon","args":[1]}
                                    },
                                    {
                                      "cmd": "assign",
                                      "target": "pkmn.name",
                                      "args": [],
                                      "op": "=",
                                      "value": null
                                    },
                                    {
                                      "cmd": "call",
                                      "fn": "pbSet",
                                      "args": [3,{"call":"name","on":{"call":"pkmn"}}]
                                    }
                                  ]
                                },
                                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                                {
                                  "cmd": "text",
                                  "text": "\\bDone! From now on, this Pokémon shall be known as \\v[3]!"
                                },
                                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                                {
                                  "cmd": "text",
                                  "text": "\\bIt looks no different from before, and yet, this is vastly superior!"
                                },
                                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                                {"cmd":"text","text":"\\bHow fortunate for you!"}
                              ],
                              "else": [
                                {
                                  "cmd": "comment",
                                  "lines": [
                                    "Retrieves the Pokémon whose party index is stored in ",
                                    "Game Variable 1, and changes its name to the name ",
                                    "stored in Game Variable 5."
                                  ]
                                },
                                {
                                  "cmd": "script",
                                  "do": [
                                    {
                                      "cmd": "assign",
                                      "target": "pkmn",
                                      "args": [],
                                      "op": "=",
                                      "value": {"call":"pbGetPokemon","args":[1]}
                                    },
                                    {
                                      "cmd": "assign",
                                      "target": "pkmn.name",
                                      "args": [],
                                      "op": "=",
                                      "value": {"call":"pbGet","args":[5]}
                                    }
                                  ]
                                },
                                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                                {
                                  "cmd": "text",
                                  "text": "\\bDone! From now on, this Pokémon shall be known as \\v[5]!"
                                },
                                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                                {
                                  "cmd": "text",
                                  "text": "\\bIt is a better name than before!\\nHow fortunate for you!"
                                }
                              ]
                            }
                          ]
                        }
                      ],
                      [
                        {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                        {"cmd":"text","text":"\\bI see.\\nDo come visit again."}
                      ]
                    ],
                    "cancel": 1
                  }
                ],
                [
                  {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                  {"cmd":"text","text":"\\bI see.\\nDo come visit again."}
                ]
              ],
              "cancel": 1
            }
          ]
        }
      ]
    }
  ]
