                        ]
                      },
                      {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                      {
                        "cmd": "text",
                        "text": "Hey there, Trainer! I see you have some powerful cards in your deck. Let's see if they can stand up to my well-crafted strategy! Get ready for a duel!"
                      },
                      {
                        "cmd": "script",
                        "ruby": "result = pbTriadDuel(\"Alex\", 0, 5, [\"elements\", \"noprize\"], \n[:CHINCHOU,:SANDSHREW,:VULPIX,:PARAS,:MACHOP])\npbSet(2, result)"
                      },
                      {
                        "cmd": "if",
                        "cond": {"variable":2,"op":"==","value":1},
                        "then": [
                          {"cmd":"comment","lines":["You won!"]},
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {
                            "cmd": "text",
                            "text": "Wow, you're a tough opponent! I didn't expect to lose. Well played! You truly deserve this victory."
                          },
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {"cmd":"text","text":"Take this card as the prize for the win."},
                          {"cmd":"call","fn":"pbGiveTriadCardWithAnimation","args":["MACHOP"]},
                          {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                          {"cmd":"selfSwitch","ch":"A","value":true}
                        ],
                        "else": [
                          {"cmd":"comment","lines":["You won!"]},
                          {
                            "cmd": "if",
                            "cond": {"variable":2,"op":"==","value":2},
                            "then": [
                              {"cmd":"comment","lines":["You lost!"]},
                              {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                              {
                                "cmd": "text",
                                "text": "Looks like my strategy was stronger this time.\\nDon't feel bad, every loss is a step closer to becoming stronger."
                              },
                              {"cmd":"gold","op":"sub","value":200}
                            ],
                            "else": [
                              {"cmd":"comment","lines":["Draw!"]},
                              {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
