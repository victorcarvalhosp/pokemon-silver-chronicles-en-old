            {"cmd":"text","text":"Roxanne, the Gym Leader, is a user of Rock- type Pokémon."},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {
              "cmd": "text",
              "text": "The Rock type is very durable, but it can't stand Water-type and Grass-type moves."
            },
