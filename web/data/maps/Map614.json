          "list": [
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"Hi! Are you really a Trainer!?"},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"I have to see your Pokédex!"},
            {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
            {"cmd":"text","text":"I'm interested in seeing the Orange Archipelago Dex..."},
            {"cmd":"call","fn":"pbSet","args":[1,{"call":"$player.pokedex.seen_count","args":[4]}]},
            {"cmd":"call","fn":"pbSet","args":[2,{"call":"$player.pokedex.owned_count","args":[4]}]},
            {
              "cmd": "text",
              "text": "Hmm, let's see..\\nYou've seen \\v[1] Pokémon, and \\nyou've caught \\v[2] Pokémon!\\nI see!"
            },
            {
              "cmd": "if",
              "cond": {"variable":2,"op":">=","value":70},
              "then": [
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"Whoa! Caught over 70!?"},
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"That's amazing!"},
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"You're really a Pro Trainer!"},
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"I noticed that you're still missing a Pokémon..."},
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"To help you to complete your Pokédex, I'll give it to you."},
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"I spend so much time at home that it is bored."},
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {
                  "cmd": "text",
                  "text": "I have other Pokémon that enjoy staying home with me, but this one wants to go on an adventure!"
                },
                {
                  "cmd": "if",
                  "cond": {"switch":822,"value":true},
                  "then": [{"cmd":"script","ruby":"pkmn = Pokemon.new(:POPPLIO,10)\npbAddPokemon(pkmn)"}],
                  "else": [
                    {
                      "cmd": "if",
                      "cond": {"switch":823,"value":true},
                      "then": [
                        {
                          "cmd": "script",
                          "ruby": "pkmn = Pokemon.new(:SPRIGATITO,10)\npbAddPokemon(pkmn)"
                        }
                      ],
                      "else": [{"cmd":"script","ruby":"pkmn = Pokemon.new(:LITTEN,10)\npbAddPokemon(pkmn)"}]
                    }
                  ]
                },
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"Please take good care of it."},
                {"cmd":"call","fn":"completeQuest","args":["ThirdStarterOrangeIslands"]},
                {"cmd":"selfSwitch","ch":"A","value":true}
              ],
              "else": [
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"That’s good. But you can do more!"},
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
                {"cmd":"text","text":"If you get over 70, come show me again!"},
                {"cmd":"call","fn":"pbCallBub","args":[2,{"call":"@event_id"}]},
