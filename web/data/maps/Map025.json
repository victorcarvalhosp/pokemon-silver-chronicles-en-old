            {"cmd":"call","fn":"pbCallBub","args":[2,2]},
            {"cmd":"text","text":"\\f[faceprofcarvalho]\\bAnd with that..."},
            {"cmd":"call","fn":"pbCallBub","args":[2,2]},
            {"cmd":"text","text":"\\f[faceprofcarvalho]\\bI'm Professor Oak, a Pokémon researcher!"},
            {"cmd":"call","fn":"pbCallBub","args":[2,2]},
            {"cmd":"text","text":"\\f[faceprofcarvalho]\\bSo you're \\PN!"},
            {"cmd":"call","fn":"pbCallBub","args":[2,2]},
            {
              "cmd": "text",
              "text": "\\f[faceprofcarvalho]\\bI was just visiting my friend Mr. Pokémon."
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,2]},
            {
              "cmd": "text",
              "text": "\\f[faceprofcarvalho]\\bI heard you were running an errand for Porfessor Elm, so I waited here."
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,2]},
            {"cmd":"text","text":"\\f[faceprofcarvalho]\\bOh! What's this?\\nA rare Pokémon!"},
            {"cmd":"call","fn":"pbCallBub","args":[2,2]},
            {
              "cmd": "text",
              "text": "\\f[faceprofcarvalho]\\bI see! You must be helping Professor Elm's research! I think I understand why Professor Elm gave you that Pokémon."
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,2]},
            {
              "cmd": "text",
              "text": "\\f[faceprofcarvalho]\\bYou will treat your Pokémon with love and care, it seems."
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,2]},
            {"cmd":"text","text":"\\f[faceprofcarvalho]\\b...Ah!"},
            {"cmd":"call","fn":"pbCallBub","args":[2,2]},
            {
              "cmd": "text",
              "text": "\\f[faceprofcarvalho]\\bYou seem to be dependable. \\nHow would you like to help me out?"
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,2]},
            {
              "cmd": "text",
              "text": "\\f[faceprofcarvalho]\\bSee? This is the latest version of the Pokédex."
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,2]},
            {
              "cmd": "text",
              "text": "\\f[faceprofcarvalho]\\bIt automatically records data on Pokémon you've seen or caught."
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,2]},
            {
              "cmd": "text",
              "text": "\\f[faceprofcarvalho]\\bIt's a high-tech encyclopedia! \\nI'd like you to have it."
            },
            {"cmd":"call","fn":"pbGetKeyItem","args":["iconPokedex"]},
            {
              "cmd": "if",
              "cond": {"script":{"op":"!","value":{"call":"$player.has_pokedex"}}},
              "then": [
                {"cmd":"assign","target":"$player.has_pokedex","args":[],"op":"=","value":true},
                {"cmd":"call","fn":"$player.pokedex.unlock","args":[0]},
                {"cmd":"call","fn":"$player.pokedex.lock","args":[1]},
                {"cmd":"switches","from":475,"to":475,"value":true}
              ],
              "else": [{"cmd":"text","text":"You already have a Pokédex."}]
            },
            {
              "cmd": "call",
              "fn": "activateQuest",
              "args": ["JohtoPokedex",{"call":"colorQuest","args":["blue"]},true]
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,2]},
            {
              "cmd": "text",
              "text": "\\f[faceprofcarvalho]\\bGo meet many kinds of Pokémon and complete that Pokédex!"
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,2]},
            {"cmd":"text","text":"\\f[faceprofcarvalho]\\bBut I've stayed too long."},
            {"cmd":"call","fn":"pbCallBub","args":[2,2]},
            {
              "cmd": "text",
              "text": "\\f[faceprofcarvalho]\\bI have to get to Goldenrod for my usual radio show."
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,2]},
            {
              "cmd": "text",
              "text": "\\f[faceprofcarvalho]\\b\\PN, I have a feeling that this is not the last time we'll meet..."
            },
            {"cmd":"call","fn":"pbCallBub","args":[2,2]},
            {
              "cmd": "text",
              "text": "\\f[faceprofcarvalho]\\bLet's exchange number just to be on the safe side."
            },
            {"cmd":"call","fn":"pbPhoneRegisterNPC","args":[52,"Professor \nOak",362]},
